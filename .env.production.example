# VibeCodium server — production environment.
# Copy to .env on the host and fill in values. Never commit the real .env.
#
# Variables marked REQUIRED will cause the server to throw on startup if absent.

# === REQUIRED — Supabase ============================================
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=

# === LLM provider (DeepSeek default) ================================
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_KEY=
LLM_MODEL=deepseek-chat

# Optional: LM Studio fallback running on the host.
# If you set this, also keep host.docker.internal mapping (already in compose).
# LOCAL_MODEL=qwen2.5-coder-32b-instruct

# Vercel deploy fallbacks (users supply their own via profile)
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# YouTube Shorts widget
YOUTUBE_API_KEY=

# === Server =========================================================
PORT=3000

# === Cloudflare Tunnel ==============================================
# Only required if you uncomment the cloudflared sidecar in docker-compose.yml.
# Generate with: cloudflared tunnel create vibecodium
CLOUDFLARE_TUNNEL_TOKEN=
